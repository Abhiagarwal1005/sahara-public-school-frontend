# Leave empty in development — vite.config.js proxies /api to localhost:8000
# (same origin, exactly as it will be in production).
#
# If the API is deployed on a different domain, put its origin here. You will
# then also need COOKIE_SAMESITE=none in the backend's .env, otherwise the
# browser will never send the refresh cookie on a cross-site request.
VITE_API_URL=
